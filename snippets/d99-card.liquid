<article class="d99-card"><a href="{{ product.url }}"><div class="card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="card-meta"><span>[ {{ product.title | upcase }} ]</span><strong>{{ product.price | money }}</strong></div><small>SKU: {{ product.selected_or_first_available_variant.sku | default: 'D99-SYSTEM' }}<br>MATERIAL: 100% COTTON</small></a></article>