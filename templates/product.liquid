<section class="d99-product"><div class="product-gallery">{% for image in product.images %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% endfor %}</div><div class="product-info"><small>FW24 COLLECTION // T-SHIRT</small><h1>{{ product.title | upcase }}</h1><div class="price">{{ product.price | money }}</div>{% form 'product', product %}<label>SIZE</label><div class="variants">{% for option in product.options_with_values %}{% for value in option.values %}<button type="button">{{ value }}</button>{% endfor %}{% endfor %}</div><select name="id" class="variant-select">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }}</option>{% endfor %}</select><button class="d99-button add" type="submit">ADD TO CART <span>⌖</span></button>{% endform %}<details><summary>TECHNICAL SPECS</summary>{{ product.description }}</details></div></section>