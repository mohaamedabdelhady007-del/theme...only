<div class="d99-page-head"><h1>CART</h1><p>[ {{ cart.item_count }} ITEMS ]</p></div><form action="{{ routes.cart_url }}" method="post"><div class="cart-list">{% for item in cart.items %}<div class="cart-row">{{ item.image | image_url: width: 300 | image_tag }}<div><h2>{{ item.product.title | upcase }}</h2><p>COLOR: {{ item.variant.title }}</p><a href="{{ item.url_to_remove }}">REMOVE</a></div><strong>{{ item.final_line_price | money }}</strong><input name="updates[]" value="{{ item.quantity }}" type="number" min="0"></div>{% endfor %}</div><div class="cart-total"><span>TOTAL</span><strong>{{ cart.total_price | money }}</strong></div><button class="d99-button checkout" name="checkout">CHECKOUT <span>↗</span></button></form>