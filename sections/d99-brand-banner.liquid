<section class="d99-brand-banner"><div class="brand-banner-copy"><small>// D99 SYSTEM / MANIFESTO 001</small><h2>{{ section.settings.heading | newline_to_br }}</h2><p>{{ section.settings.body | newline_to_br }}</p><a class="d99-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span>↗</span></a></div><div class="brand-banner-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy' }}{% else %}<div class="art-mark">D99<span>+</span></div><div class="art-lines">NO HANDOUTS.<br>NO SHORTCUTS.<br>ALL ACTION.</div>{% endif %}<b class="art-stamp">BUILT<br>DIFFERENT</b></div></section>
{% schema %}{"name":"D99 Brand Manifesto","settings":[{"type":"image_picker","id":"image","label":"Section image"},{"type":"textarea","id":"heading","label":"Heading","default":"WE'RE NOT HERE\nTO FIT IN."},{"type":"textarea","id":"body","label":"Body","default":"WE BUILD WHAT'S NEXT.\nUNITED BY PURPOSE.\nDRIVEN BY ACTION."},{"type":"text","id":"button_label","label":"Button label","default":"DISCOVER THE DISTRICT"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"D99 Brand Manifesto"}]}{% endschema %}