<header class="d99-header">
  <button class="d99-menu" aria-label="Menu"><i></i><i></i><i></i></button>
  <a class="d99-logo" href="{{ routes.root_url }}">{% if section.settings.logo %}{{ section.settings.logo | image_url: width: 360 | image_tag: alt: shop.name }}{% else %}D99{% endif %}</a>
  <nav>
    <div class="d99-nav-dropdown"><a href="/collections/t-shirts">T-SHIRTS <span class="nav-arrow" role="button" tabindex="0" aria-label="Show T-shirts categories">⌄</span></a><div class="d99-submenu"><a href="/collections/oversize">OVERSIZE</a><a href="/collections/premium">PREMIUM</a></div></div>
    <a href="/collections/hoodies">HOODIES</a><a href="/collections/jeans">JEANS</a>
  </nav>
  <div class="d99-actions"><a href="{{ routes.search_url }}">SEARCH (⌕)</a><a href="{{ routes.cart_url }}">CART [{{ cart.item_count }}]</a></div>
</header>
{% schema %}{"name":"D99 Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"}],"presets":[{"name":"D99 Header"}]}{% endschema %}