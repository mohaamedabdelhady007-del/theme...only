<section class="d99-hero" style="--hero-bg: url({{ section.settings.image | image_url: width: 1800 }});"><div class="hero-copy"><small>{{ section.settings.eyebrow }}</small><h1>{{ section.settings.heading | newline_to_br }}</h1><p>{{ section.settings.subheading | newline_to_br }}</p><a class="d99-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span>↗</span></a></div><div class="hero-image">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager' }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div></section>
{% schema %}{"name":"D99 Hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUILT DIFFERENT. MOVING LOUD."},{"type":"textarea","id":"heading","label":"Heading","default":"ACTION\nIS THE BRIDGE"},{"type":"textarea","id":"subheading","label":"Subheading","default":"D99 SYSTEM / DROP 01\nBUILT FOR THE PRESENT. DESIGNED FOR THE FUTURE."},{"type":"text","id":"button_label","label":"Button label","default":"ENTER THE DISTRICT"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"D99 Hero"}]}{% endschema %}