<section class="d99-lookbook"><div class="lookbook-head"><div><small>// D99 LOOKBOOK / FIELD UNIT</small><h2>{{ section.settings.heading | newline_to_br }}</h2></div><p>{{ section.settings.intro }}</p></div><div class="lookbook-grid">{% if section.blocks.size == 0 %}{% for i in (1..10) %}<div class="lookbook-card"><div class="lookbook-empty">UPLOAD<br>LOOK {{ i | prepend: '0' | slice: -2, 2 }}</div><div class="lookbook-overlay"><span>FIELD UNIT {{ i }}</span><b>ADD FULL BODY IMAGE</b><i>+</i></div></div>{% endfor %}{% else %}{% for block in section.blocks %}<a class="lookbook-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% else %}{% case forloop.index %}{% when 1 %}{{ 'images/lookbook-01.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 2 %}{{ 'images/lookbook-02.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 3 %}{{ 'images/lookbook-03.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 4 %}{{ 'images/lookbook-04.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 5 %}{{ 'images/lookbook-05.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 6 %}{{ 'images/lookbook-06.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 7 %}{{ 'images/lookbook-07.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 8 %}{{ 'images/lookbook-08.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 9 %}{{ 'images/lookbook-09.jpg' | asset_url | image_tag: loading: 'lazy' }}{% when 10 %}{{ 'images/lookbook-10.jpg' | asset_url | image_tag: loading: 'lazy' }}{% endcase %}{% endif %}<div class="lookbook-overlay"><span>{{ block.settings.label }}</span><b>{{ block.settings.title }}</b><i>↗</i></div></a>{% endfor %}{% endif %}</div></section>
{% schema %}{"name":"D99 Full Body Lookbook","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"THE DISTRICT\nIN MOTION"},{"type":"text","id":"intro","label":"Intro","default":"LIVE WITH INTENT. ACT WITHOUT FEAR."}],"blocks":[{"type":"look","name":"Full body look","settings":[{"type":"image_picker","id":"image","label":"Full body image"},{"type":"text","id":"label","label":"Label","default":"FIELD UNIT 001"},{"type":"text","id":"title","label":"Title","default":"BUILT DIFFERENT"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"D99 Full Body Lookbook","blocks":[{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"},{"type":"look"}]}]}{% endschema %}