<section class="d99-showcase d99-style-{{ section.settings.style }}">
  <div class="d99-section-title"><h2>{{ section.settings.heading }}</h2><a href="{{ section.settings.collection.url | default: '/collections/all' }}">VIEW ALL →</a></div>
  <div class="d99-showcase-grid">{% assign featured = section.settings.collection | default: collections.all %}{% for product in featured.products limit: 4 %}<article class="showcase-card"><a href="{{ product.url }}"><div class="showcase-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}<span class="crosshair">⌖</span>{% if forloop.first and section.settings.style == '05' %}<b class="drop-stamp">LIMITED DROP</b>{% endif %}</div><div class="showcase-info"><div><small>{% if section.settings.style == '04' %}PRODUCT ID // D99-{{ forloop.index }}{% else %}[ {{ product.title | upcase }} ]{% endif %}</small><h3>{{ product.title | upcase }}</h3></div><strong>{{ product.price | money }}</strong></div><small class="showcase-spec">SKU: {{ product.selected_or_first_available_variant.sku | default: 'D99-TS-00' }}<br>MATERIAL: 100% COTTON</small></a></article>{% endfor %}</div>
</section>
{% schema %}{"name":"D99 Product Showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"NEW ARRIVALS"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"style","label":"Design style","default":"01","options":[{"value":"01","label":"01 — Technical Card"},{"value":"02","label":"02 — Industrial Catalog"},{"value":"03","label":"03 — Editorial"},{"value":"04","label":"04 — Archive"},{"value":"05","label":"05 — Limited Drop"}]}],"presets":[{"name":"D99 Product Showcase"}]}{% endschema %}